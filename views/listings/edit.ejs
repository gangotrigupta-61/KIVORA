
<% layout("/layouts/boilerplate") %>

<body>
    <h2>Edit your listing</h2>
    <form method="post"  action="/listings/<%=listing._id%>?_method=PUT" >
         <input type="text" name="listing[title]" id="" 
         value="<%= listing.title %>">
        <br><br>
        <textarea name="listing[description]">
            <%= listing.description %></textarea>
        <br><br>
        <input type="text" name="listing[image]" value="<%= listing.image.url %>" id="">
        <br><br>
        <input type="number" name="listing[price]" 
        value="<%= listing.price %>">
        <br><br>
        <input type="text" name="listing[country]" id="" value="<%= listing.country %>">
        <br><br>
        <input type="text" name="listing[location]" id="" value="<%= listing.location %>">
        <br><br>
        <button>EDIT</button>
    </form>
</body>
