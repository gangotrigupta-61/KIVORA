<% layout("/layouts/boilerplate") %>


    <div class="row">
        <div class="col-8 offset-2" >
<br><br>
    <h3>Create a New Listing</h3>
    <form action="/listings" method="post">

        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" id="" placeholder="Add a catchy title" class="form-control">
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" id="" placeholder="" class="form-control"></textarea>
       </div>

       <div class="mb-3">
         <label for="image" class="form-label">ImageLink</label>
        <input type="text" name="listing[image][url]" placeholder="enter image URL/link" id="" class="form-control">
      </div>


    <div class="row">
      <div class="mb-3 col-md-4">
         <label for="Price" class="form-label">Price</label>
        <input type="number" name="listing[price]" 
        placeholder="1200" class="form-control">
       </div>

       <div class="mb-3 col-md-8">
         <label for="country" class="form-label">Country</label>
        <input type="text" name="listing[country]" id="" placeholder="India" class="form-control">
        </div>
    </div>

        <div class="mb-3">
             <label for="location" class="form-label">Location
             </label>
        <input type="text" name="listing[location]" id="" placeholder="Jaipur,Rajasthan" class="form-control">
       </div>
<br><br>
        <button class="btn btn-dark add-btn mt-3">ADD</button>
        <br><br><br>
    </form>

</div>
</div>