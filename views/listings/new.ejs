<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KIVORA</title>
</head>
<body>
    <h3>Create a New Listing</h3>
    <form action="/listings" method="post">

        <input type="text" name="listing[title]" id="" placeholder="entertitle">
        <br><br>
        <textarea name="listing[description]" id="" placeholder="enter description"></textarea>
        <br><br>
        <input type="text" name="listing[image]" placeholder="enter image URL/link" id="">
        <br><br>
        <input type="number" name="listing[price]" 
        placeholder="enter price">
        <br><br>
        <input type="text" name="listing[country]" id="" placeholder="enter country name">
        <br><br>
        <input type="text" name="listing[location]" id="" placeholder="enter location">
        <br><br>

        <button>ADD</button>
    </form>
</body>
</html>